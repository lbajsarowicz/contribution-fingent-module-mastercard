{
  "name": "fingent/module-mastercard",
  "description": "Official Magento2 Plugin to integrate with MasterCard Payments by Fingent",
  "type": "magento2-module",
  "license": "Apache-2.0",
  "version": "3.0.4",
  "require": {
        "php": "^8.2"
    },
  "authors": [
    {
      "name": "The Fingent Team",
      "email": "support@fingent.com",
      "homepage": "https://www.fingent.com",
      "role": "Technical Support"
    }
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Mastercard\\Mastercard\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
